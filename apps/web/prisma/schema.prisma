generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id         String      @id @default(cuid())
  task       String
  createdAt  DateTime    @default(now())
  status     String      @default("PENDING")
  verdict    String?
  sentence   String?
  
  agentRuns  AgentRun[]
  exhibits   Exhibit[]
  arguments  Argument[]
  juryVotes  JuryVote[]
}

model AgentRun {
  id            String        @id @default(cuid())
  caseId        String
  variant       String
  cost          Float         @default(0)
  budget        Float         @default(0.50)
  summary       String?
  guildTraceId  String?
  createdAt     DateTime      @default(now())
  
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  toolCalls     ToolCall[]
}

model ToolCall {
  id            String    @id @default(cuid())
  agentRunId    String
  tool          String
  input         String
  output        String?
  cost          Float
  latencyMs     Int
  guildSpanId   String?
  createdAt     DateTime  @default(now())
  
  agentRun      AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
}

model Exhibit {
  id          String       @id @default(cuid())
  caseId      String
  kind        String
  sourceUrl   String?
  hash        String?
  payloadRef  String
  createdAt   DateTime     @default(now())
  
  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Argument {
  id               String     @id @default(cuid())
  caseId           String
  role             String
  text             String
  citedExhibitIds  String
  createdAt        DateTime   @default(now())
  
  case             Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model JuryVote {
  id          String        @id @default(cuid())
  caseId      String
  jurorId     Int
  rubric      String
  scores      String
  verdict     String
  rationale   String
  createdAt   DateTime      @default(now())
  
  case        Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
}
